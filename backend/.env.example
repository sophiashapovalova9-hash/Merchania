# --- Порт API ---
PORT=4000

# --- Режим мока: true = сервер работает без SQL Server (данные из src/db/mock-data.js) ---
MOCK_DB=true

# --- Подключение к SQL Server (используется когда MOCK_DB=false) ---
DB_SERVER=localhost
DB_PORT=1433
# Если SQL Server установлен на Windows как именованный инстанс (обычно SQLEXPRESS),
# раскомментируй строку ниже — тогда DB_PORT игнорируется, порт узнаёт SQL Browser:
# DB_INSTANCE=SQLEXPRESS
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_DATABASE=ArtistMerchDB
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# --- CORS: адрес фронта через запятую (или * для разработки) ---
CORS_ORIGIN=http://localhost:5173

# --- Заглушка авторизации: чей профиль считать текущим, пока нет JWT ---
DEMO_USER_ID=1
